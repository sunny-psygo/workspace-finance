// 一本账：账户是科目树，分录是一次平衡的记账，过账行是分录落到账户上的金额。
// 金额用分，避免浮点。方向只有借、贷。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id
  username     String    @unique
  displayName  String
  // bcrypt 哈希，绝不存明文
  passwordHash String
  // 逗号分隔：employee,finance,gm,cashier,hr
  roles        String
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Book {
  id             String           @id
  name           String
  currency       String           @default("CNY")
  createdAt      DateTime         @default(now())
  accounts       Account[]
  entries        Entry[]
  claims         Claim[]
  statements     BankStatement[]
  periods        AccountingPeriod[]
  yearCloses     YearClose[]
  payrollBatches PayrollBatch[]
}

model AccountingPeriod {
  id        String   @id
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id])
  // YYYY-MM
  yearMonth String
  lockedAt  DateTime @default(now())
  lockedBy  String
  remark    String   @default("")

  @@unique([bookId, yearMonth])
}

// 年末把本年利润结到未分配利润；entryId 空表示当年利润本就为 0
model YearClose {
  id        String   @id
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id])
  year      Int
  entryId   String?
  closedBy  String
  remark    String   @default("")
  closedAt  DateTime @default(now())
  reversedAt DateTime?
  reverseEntryId String?
  reverseRemark String @default("")

  @@unique([bookId, year])
}

model Account {
  id        String   @id
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id])
  code      String
  name      String
  // asset | liability | equity | income | expense
  kind      String
  parentId  String?
  normal    String
  createdAt DateTime @default(now())
  postings  Posting[]

  @@unique([bookId, code])
}

model Entry {
  id          String    @id
  bookId      String
  book        Book      @relation(fields: [bookId], references: [id])
  occurredOn  String
  memo        String
  // 调用方提供的幂等键。同一本账里重复提交返回原分录。
  reference   String?
  createdAt   DateTime  @default(now())
  postings    Posting[]

  @@unique([bookId, reference])
}

model Posting {
  id        String  @id
  entryId   String
  entry     Entry   @relation(fields: [entryId], references: [id])
  accountId String
  account   Account @relation(fields: [accountId], references: [id])
  // debit | credit
  side      String
  // 金额，单位：分。必须为正。
  cents     Int
}

// 报销单据：审批状态机。总经理通过时调用账本 postEntry，不另做一套账。
model Claim {
  id                  String      @id
  bookId              String
  book                Book        @relation(fields: [bookId], references: [id])
  // 本版只做 expense
  requestType         String      @default("expense")
  status              String      @default("draft")
  revision            Int         @default(0)
  lastMutationId      String?
  applicant           String
  department          String
  costCenter          String
  payeeName           String
  payeeAccount        String
  bankName            String
  purpose             String
  occurredOn          String
  expenseAccountCode  String      @default("5602")
  payableAccountCode  String      @default("2241")
  totalCents          Int         @default(0)
  // 已通过银行流水核销的应付金额（分）
  paidCents           Int         @default(0)
  entryId             String?
  paymentEntryId      String?
  remark              String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  items               ClaimItem[]
  events              ClaimEvent[]
  allocations         PaymentAllocation[]

  @@index([bookId, status])
}

model ClaimItem {
  id          String            @id
  claimId     String
  claim       Claim             @relation(fields: [claimId], references: [id], onDelete: Cascade)
  category    String            @default("")
  memo        String
  // 规范化后的发票号；空串表示无票/不参与查重
  invoiceNo   String            @default("")
  cents       Int
  attachments ClaimAttachment[]

  @@index([invoiceNo])
}

model ClaimAttachment {
  id          String    @id
  claimItemId String
  claimItem   ClaimItem @relation(fields: [claimItemId], references: [id], onDelete: Cascade)
  fileName    String
  contentType String    @default("application/octet-stream")
  byteSize    Int
  storagePath String
  uploadedBy  String
  createdAt   DateTime  @default(now())

  @@index([claimItemId])
}

model ClaimEvent {
  id         String   @id
  claimId    String
  claim      Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  action     String
  fromStatus String
  toStatus   String
  actor      String
  role       String
  mutationId String
  remark     String?
  createdAt  DateTime @default(now())

  @@unique([claimId, mutationId])
}

// 银行支出流水：可分次匹配到待付款单据；从未匹配的可作废
model BankStatement {
  id                 String                      @id
  bookId             String
  book               Book                        @relation(fields: [bookId], references: [id])
  paidOn             String
  // 流出为正（分）
  cents              Int
  remainingCents     Int
  bankAccountCode    String
  reference          String
  counterparty       String                      @default("")
  remark             String                      @default("")
  createdAt          DateTime                    @default(now())
  voidedAt           DateTime?
  voidedBy           String                      @default("")
  voidRemark         String                      @default("")
  allocations        PaymentAllocation[]
  payrollAllocations PayrollPaymentAllocation[]

  @@unique([bookId, reference])
  @@index([bookId, remainingCents])
}

// 工资批次：人事提报 → 试算个税 → 财务确认 → 过账 → 银行付实发
model PayrollBatch {
  id                   String                      @id
  bookId               String
  book                 Book                        @relation(fields: [bookId], references: [id])
  // YYYY-MM
  period               String
  taxPeriod            String
  // draft | calculated | taxVerified | posted | paid
  status               String                      @default("draft")
  revision             Int                         @default(0)
  lastMutationId       String?
  grossCents           Int                         @default(0)
  employeeSiCents      Int                         @default(0)
  housingFundCents     Int                         @default(0)
  otherDeductionCents  Int                         @default(0)
  employerSiCents      Int                         @default(0)
  employerHfCents      Int                         @default(0)
  taxCents             Int                         @default(0)
  netCents             Int                         @default(0)
  paidCents            Int                         @default(0)
  entryId              String?
  lockedAt             DateTime?
  lockedBy             String                      @default("")
  remark               String                      @default("")
  createdBy            String
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  lines                PayrollLine[]
  payments             PayrollPaymentAllocation[]

  @@index([bookId, period])
  @@index([bookId, status])
}

model PayrollLine {
  id                 String       @id
  batchId            String
  batch              PayrollBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  personCode         String
  personName         String
  grossCents         Int
  employeeSiCents    Int          @default(0)
  housingFundCents   Int          @default(0)
  otherDeductionCents Int         @default(0)
  employerSiCents    Int          @default(0)
  employerHfCents    Int          @default(0)
  // 计算用的期初累计（分）
  priorGrossCents    Int          @default(0)
  priorSiCents       Int          @default(0)
  priorHfCents       Int          @default(0)
  priorTaxCents      Int          @default(0)
  estimatedTaxCents  Int          @default(0)
  confirmedTaxCents  Int          @default(0)
  taxAdjustReason    String       @default("")
  netCents           Int          @default(0)
  sortOrder          Int          @default(0)

  @@index([batchId])
  @@index([personCode])
}

// 工资实发与银行流水的一次匹配
model PayrollPaymentAllocation {
  id                String        @id
  batchId           String
  batch             PayrollBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  statementId       String
  statement         BankStatement @relation(fields: [statementId], references: [id])
  cents             Int
  entryId           String
  mutationId        String
  remark            String        @default("")
  uploadedBy        String
  createdAt         DateTime      @default(now())
  reversedAt        DateTime?
  reverseEntryId    String?
  reverseMutationId String?
  reverseRemark     String        @default("")

  @@unique([batchId, mutationId])
  @@index([statementId])
}

// 流水与报销单的一次匹配：借应付、贷银行；撤销后写红冲并标 reversedAt
model PaymentAllocation {
  id                 String        @id
  claimId            String
  claim              Claim         @relation(fields: [claimId], references: [id], onDelete: Cascade)
  statementId        String
  statement          BankStatement @relation(fields: [statementId], references: [id])
  cents              Int
  entryId            String
  mutationId         String
  voucherNo          String        @default("")
  fileName           String        @default("")
  storagePath        String        @default("")
  remark             String        @default("")
  uploadedBy         String
  createdAt          DateTime      @default(now())
  reversedAt         DateTime?
  reverseEntryId     String?
  reverseMutationId  String?
  reverseRemark      String        @default("")

  @@unique([claimId, mutationId])
  @@index([statementId])
}
